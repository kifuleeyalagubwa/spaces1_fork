                        continue
        
        # Method 2: URL parameter
        if not institution and 'institution' in request.GET:
            subdomain = request.GET['institution']
            print(f"DEBUG: Trying URL parameter: {subdomain}")
            try:
                institution = Institution.objects.get(
                    subdomain=subdomain,
                    is_active=True,
                    is_approved=True
                )
                request.session['current_institution_id'] = str(institution.id)
                print(f"DEBUG: Institution found via URL parameter: {institution.name}")
            except Institution.DoesNotExist:
