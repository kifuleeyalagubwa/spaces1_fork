        # Method 3: Session
        if not institution and 'current_institution_id' in request.session:
            institution_id = request.session['current_institution_id']
            print(f"DEBUG: Trying session institution: {institution_id}")
            try:
                institution = Institution.objects.get(
                    id=institution_id,
                    is_active=True,
                    is_approved=True
                )
                print(f"DEBUG: Institution found in session: {institution.name}")
            except Institution.DoesNotExist:
                print(f"DEBUG: No institution found in session: {institution_id}")
                del request.session['current_institution_id']
        
        # Method 4: User profile
        if not institution and request.user.is_authenticated:
            print(f"DEBUG: Checking user profile for institution")
            try:
                if hasattr(request.user, 'profile') and request.user.profile.institution:
                    institution = request.user.profile.institution
                    request.session['current_institution_id'] = str(institution.id)
                    print(f"DEBUG: Institution found in user profile: {institution.name}")
            except Exception as e:
                print(f"DEBUG: Error checking user profile: {e}")
        
        if institution:
            set_current_institution(institution)
            request.institution = institution
            print(f"DEBUG: FINAL - Institution set to: {institution.name}")
        else:
